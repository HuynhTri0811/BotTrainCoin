{
  "ConnectionStrings": {
    "Bot": "Data Source=data/cryptobot.db;Default Timeout=30"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Binance": {
    "MarketDataBaseUrl": "https://api.binance.com",
    "FuturesMarketDataBaseUrl": "https://fapi.binance.com",
    "RequestTimeout": "00:00:10"
  },
  "MarketData": {
    "BootstrapCandles": 1000,
    "BatchSize": 1000,
    "PollInterval": "00:00:15",
    "StaleAfter": "00:02:00"
  },
  "Signals": {
    "MaxFreshAge": "00:02:00"
  },
  "LivePrices": {
    "PollInterval": "00:00:15",
    "HistorySize": 240,
    "Symbols": [ "BTCUSDT", "ETHUSDT" ]
  },
  "PaperFutures": {
    "StartingBalance": 1000,
    "TakerFeeRate": 0.0005,
    "SlippageRate": 0.0005,
    "MaxLeverage": 10,
    "MarkPriceMaxAge": "00:00:10",
    "MarkPollInterval": "00:00:02",
    "Symbols": [
      { "Symbol": "BTCUSDT", "QuantityStep": 0.001, "TickSize": 0.1, "MinNotional": 50, "MaintenanceMarginRate": 0.004 },
      { "Symbol": "ETHUSDT", "QuantityStep": 0.001, "TickSize": 0.01, "MinNotional": 20, "MaintenanceMarginRate": 0.005 }
    ]
  },
  "AutoOrders": {
    "DefaultMargin": 50,
    "DefaultLeverage": 2,
    "DefaultStopLossPercent": 1,
    "DefaultTakeProfitPercent": 2,
    "DailyLossLimitPercent": 5,
    "MaxActiveRules": 10
  },
  "Indicators": [
    {
      "Name": "btc-1h-myrsi",
      "Type": "MyRsi",
      "Symbol": "BTCUSDT",
      "Interval": "1h",
      "Parameters": { "Period": 14, "Oversold": 30, "Overbought": 70, "LookbackCandles": 200 }
    },
    {
      "Name": "eth-15m-myrsi-trend",
      "Type": "MyRsi",
      "Symbol": "ETHUSDT",
      "Interval": "15m",
      "Parameters": { "Period": 14, "Oversold": 30, "Overbought": 70, "TrendEmaPeriod": 50, "LookbackCandles": 200 }
    }
  ],
  "Strategies": [
    {
      "Name": "btc-1h-ema",
      "Type": "EmaCross",
      "Symbol": "BTCUSDT",
      "Interval": "1h",
      "Enabled": true,
      "Parameters": { "FastPeriod": 9, "SlowPeriod": 21, "LookbackCandles": 300 }
    },
    {
      "Name": "btc-15m-ema",
      "Type": "EmaCross",
      "Symbol": "BTCUSDT",
      "Interval": "15m",
      "Enabled": true,
      "Parameters": { "FastPeriod": 9, "SlowPeriod": 21, "LookbackCandles": 300 }
    },
    {
      "Name": "eth-15m-ema",
      "Type": "EmaCross",
      "Symbol": "ETHUSDT",
      "Interval": "15m",
      "Enabled": true,
      "Parameters": { "FastPeriod": 9, "SlowPeriod": 21, "LookbackCandles": 300 }
    }
  ]
}
